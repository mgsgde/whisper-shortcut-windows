<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- sherpa-onnx ships native DLLs (onnxruntime, sherpa-onnx-c-api); a single-file exe must carry them. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built by tools/make_icon.py from the macOS app icon. -->
    <EmbeddedResource Include="app.ico" LogicalName="WhisperShortcut.app.ico" />
    <EmbeddedResource Include="recording.ico" LogicalName="WhisperShortcut.recording.ico" />
    <EmbeddedResource Include="processing.ico" LogicalName="WhisperShortcut.processing.ico" />
    <!-- llama.cpp's Windows builds need the VC++ runtime, which a fresh Windows lacks. Taken from
         Microsoft's vc_redist (app-local deployment is allowed); OfflineEngine puts them beside llama-server.exe. -->
    <EmbeddedResource Include="..\..\third_party\vcruntime\$(RuntimeIdentifier)\*.dll"
                      LogicalName="WhisperShortcut.vcruntime.%(Filename)%(Extension)"
                      Condition="'$(RuntimeIdentifier)' != ''" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WhisperShortcut.Core\WhisperShortcut.Core.csproj" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

</Project>
